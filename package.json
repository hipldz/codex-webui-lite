{
  "name": "codex-web-harness",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "dev": "tsx server/index.ts --dev",
    "build": "tsc --noEmit && vite build && node scripts/compress.mjs && tsc -p tsconfig.server.json",
    "start": "node --max-old-space-size=256 dist-server/index.js"
  },
  "dependencies": {
    "lucide-react": "1.34.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "7.1.3"
  }
}
